# ============ Telegram ============
# Token from @BotFather. Without it the bot and auto-analysis are disabled, only the Mini App works.
BOT_TOKEN=

# Public HTTPS address of the server where Telegram sends the webhook (no trailing slash).
# E.g. https://chessanalys.uk   (for local dev use a tunnel: ngrok/cloudflared)
WEBHOOK_BASE_URL=

# Any random string — webhook protection (Telegram returns it in a header).
WEBHOOK_SECRET=change-me

# Mini App link for the "Open review" button (from BotFather → Mini App).
# E.g. https://t.me/MyBot/app   (if empty — the button points to WEBHOOK_BASE_URL/?game=...)
MINIAPP_DEEPLINK=

# Bot admin (author). Username without @ — the /admin command is available only to them.
# You can additionally set ADMIN_ID (numeric tg_id) for a strict binding.
ADMIN_USERNAME=
# ADMIN_ID=

# ============ Stockfish / analysis ============
# In docker-compose the path is overridden to /usr/games/stockfish
STOCKFISH_PATH=./stockfish.exe
ENGINE_DEPTH=13
ENGINE_THREADS=1
ENGINE_HASH=64
MAX_PLIES=300
MAX_PGN_CHARS=100000

# ============ DB / scheduler ============
DB_PATH=chessanalis.db
POLL_INTERVAL_SECONDS=120
ANALYSIS_MAX_GAMES_PER_POLL=3
CHESSCOM_USER_AGENT=ChessAnalisBot/1.0 (contact: you@example.com)
